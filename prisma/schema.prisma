model Post {
  id        Int       @id
  title     String
  content   String
  userId    String
  mediaType MediaType
  imageUrl  String
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  thumbnail String
  url       String
  price     Int
  orders    Order[] // Many-to-Many via Join Table (for paid premium posts)

  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  document  Document? // Reverse of One-to-One relation with Document
  purchases Purchase[]

  @@index([userId])
  @@map("post")
}


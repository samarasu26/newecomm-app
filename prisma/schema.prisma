model Faq {
  id        String   @id
  question  String
  answer    String
  category  String? // optional grouping, e.g. "Billing", "Account"
  order     Int      @default(0) // controls display order within a category
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("faqs")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Link {
  url String @unique
}

model Order {
  id          Int         @id
  status      OrderStatus @default(PENDING)
  totalAmount Float
  userEmail   String // Tracks who bought the item
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  postId                Int?
  post                  Post?     @relation(fields: [postId], references: [id])
  documentId            String
  document              Document? @relation(fields: [documentId], references: [id])
  user                  User?     @relation(fields: [userId], references: [id])
  userId                String?
  stripePaymentIntentId String
  amountInCents         Int
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

model Document {
  id        String    @id
  name      String
  fileUrl   String
  imageUrl  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  userId    String
  // A premium document can be purchased in multiple orders
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int?      @unique // One-to-One: A draft can be linked to a single published post
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  price     Int
  mediaType MediaType
}

model Purchase {
  id              Int      @id
  amount          Float    @default(0.0) // Store prices as floats (e.g., 9.99)
  currency        String   @default("USD")
  status          String   @default("PENDING") // e.g., PENDING, COMPLETED, FAILED
  paymentIntentId String?  @unique // For mapping to Stripe/PayPal transactions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])
  postId Int
  post   Post   @relation(fields: [postId], references: [id])

  @@index([userId, postId]) // Optimize dashboard lookups
}
